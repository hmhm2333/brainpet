{
  "schemaVersion": 1,
  "bridgeVersion": "0.3.0",
  "minimumRuntimeIpcVersion": 1,
  "hookDeadlineMs": 2600,
  "connectAttemptMs": 350,
  "provider": "codex",
  "emittedStates": ["working", "ready", "blocked", "idle"],
  "transportPriority": ["native-hook"],
  "releaseTargets": ["windows-x64", "windows-arm64", "macos-x64", "macos-arm64", "linux-x64", "linux-arm64"],
  "privacy": {
    "allowedFields": ["schemaVersion", "agent", "sessionId", "state", "occurredAt", "capabilities", "turnId", "request"],
    "rejectedFields": ["prompt", "transcript", "cwd", "toolInput", "toolOutput", "response"]
  }
}
